# Copy to .env.local. Never commit real credentials.
# Use a separate Supabase project, Razorpay keys and webhook secret for each mode.
APP_URL=http://localhost:3000
PAYMENTS_MODE=test
LIVE_PAYMENTS_ENABLED=false

RAZORPAY_KEY_ID=rzp_test_U4M9Eobt2sOG4f
RAZORPAY_KEY_SECRET=xxzB8HU7huSRacyu3lw3ZcNy
RAZORPAY_WEBHOOK_SECRET=
# Set true ONLY after confirming USD payments are enabled for this merchant/mode.
# Checkout refuses to create orders while false. No INR or exchange-rate fallback.
RAZORPAY_USD_ENABLED=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate a unique random value of at least 32 characters for each environment.
# Keep stable: changing it invalidates existing anonymous sessions/recovery hashes.
SESSION_TOKEN_PEPPER=
# Optional only behind a proxy that removes/overwrites this client header.
# Allowed: x-real-ip, cf-connecting-ip, x-vercel-forwarded-for.
# Empty uses a conservative shared rate-limit bucket plus session/email limits.
TRUSTED_PROXY_IP_HEADER=

# Transactional recovery mail; use a verified sender domain.
RESEND_API_KEY=
LICENSE_EMAIL_FROM=Stocky History Rescue <licenses@example.com>

# Explicit local archive test bypass. Never honored in production.
# Keep false when testing checkout or authorization.
NEXT_PUBLIC_EXPORT_TEST_BYPASS=false
